set positional-arguments

# justfile config
# lists all recipes so you can quickly discover available workflows.
default: help

help:
  @just --list

# docs navigation
# displays a subtree with repo-aware path resolution for quick structure
# checks. use `just tree -h` for usage.
tree *args:
    @bash "{{justfile_directory()}}/scripts/dev/justfile/tree.sh" "$@"

# project config
# creates or updates the project Mamba environment.
bootstrap:
  @bash "{{justfile_directory()}}/scripts/dev/justfile/ml.sh" bootstrap

# updates the project mamba environment after adding/removing dependencies.
update-env:
  @bash "{{justfile_directory()}}/scripts/dev/justfile/ml.sh" update-env

# removes the project mamba environment from this machine.
remove-env:
  @bash "{{justfile_directory()}}/scripts/dev/justfile/ml.sh" remove-env

# prints the shell commands needed to activate the environment.
activate:
  @bash "{{justfile_directory()}}/scripts/dev/justfile/ml.sh" activate

# prints the shell command needed to deactivate the environment.
deactivate:
  @bash "{{justfile_directory()}}/scripts/dev/justfile/ml.sh" deactivate

# verifies core imports, a minimal audio transform, and local research tools.
env-check:
  @bash "{{justfile_directory()}}/scripts/dev/justfile/ml.sh" env-check

# starts JupyterLab rooted at research/.
jupyter-lab *args:
  @bash "{{justfile_directory()}}/scripts/dev/justfile/ml.sh" run jupyter lab --ServerApp.root_dir="{{justfile_directory()}}" "$@"

# starts TensorBoard against the local generated-run directory.
tensorboard *args:
  @bash "{{justfile_directory()}}/scripts/dev/justfile/ml.sh" run tensorboard --logdir="{{justfile_directory()}}/reports/tensorboard" "$@"
